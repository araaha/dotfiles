{
    "$schema": "https://opencode.ai/v2/cli.json",
    "theme": {
        "name": "gruvbox-transparent"
    },
    "tabs": {
        "mode": "off",
        "layout": "vertical",
        "indicators": "status",
        "scope": "global"
    },
    "session": {
        "thinking": "show",
        "sidebar": "hide",
        "scrollbar": false,
        "markdown": "rendered",
        "grouping": "auto",
        "verbosity": "high",
        "tps": true,
        "permissions": "prompt"
    },
    "keybinds": {
        "leader": "ctrl+space",
        "prompt.autocomplete.hide": "escape,ctrl+e"
    },
    "plugins": [
        { "package": "./plugins/vim-mini" },
        { "package": "./plugins/notify" }
    ],
    "diffs": {
      "fullscreen": false,
      "view": "unified"
    },
    "animations": false,
    "scroll": {
      "acceleration": true,
      "speed": 3.5
    },
    "attention": {
      "notifications": false,
      "sound": false
    }
}

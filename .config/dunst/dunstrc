[global]
    width = 400
    offset = 0
    #origin = top-center

    progress_bar_min_width = 380
    progress_bar_max_width = 380
    progress_bar_corner_radius = 0

    padding = 10
    horizontal_padding = 10
    frame_width = 2
    gap_size = 1
    font = "MesloLGS NF 15"

    corner_radius = 0

    foreground = "#ebdbb2"
    background = "#242424d1"

    idle_threshold = 120
    #separator_color = "#9cd365"
    #separator_height = 4

    ignore_dbusclose = true
    timeout = 5

[urgency_low]
    highlight = "#83a598"
    frame_color = "#83a598"
    format = "<b><span foreground='#83a598'>%s</span></b>\n%b"

[urgency_normal]
    highlight = "#fabd2f"
    frame_color = "#fabd2f"
    format = "<b><span foreground='#fabd2f'>%s</span></b>\n%b"

[urgency_critical]
    highlight = "#fb4934"
    frame_color = "#fb4934"
    format = "<b><span foreground='#fb4934'>%s</span></b>\n%b"
    timeout = 10


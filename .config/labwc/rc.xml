<?xml version="1.0" encoding="UTF-8"?>
<!-- Migrated from ~/.config/openbox for Labwc. -->
<openbox_config xmlns="http://openbox.org/3.4/rc" xmlns:xi="http://www.w3.org/2001/XInclude">
  <core>
    <decoration>server</decoration>
    <allowTearing>no</allowTearing>
    <hideCursorTime>10000</hideCursorTime>
  </core>
  <resistance>
    <windowEdgeStrength>10</windowEdgeStrength>
    <screenEdgeStrength>20</screenEdgeStrength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <!-- always try to focus new windows when they appear. other rules do
       apply -->
    <followMouse>yes</followMouse>
    <!-- move focus to a window when you move the mouse into it -->
    <focusLast>yes</focusLast>
    <!-- focus the last used window when changing desktops, instead of the one
       under the mouse pointer. when followMouse is enabled -->
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <!-- move focus under the mouse, even when the mouse is not moving -->
    <raiseOnFocus>no</raiseOnFocus>
    <!-- when followMouse is enabled, and a window is given focus by moving the
       mouse into it, also raise the window -->
  </focus>
  <placement>
    <policy>automatic</policy>
  </placement>
  <theme>
    <name>gruvbox-material-dark-blocks</name>
    <titlebar>
      <layout>icon:iconify,max,close,shade,desk</layout>
    </titlebar>
    <!--
      available characters are NDSLIMC, each can occur at most once.
      N: window icon
      L: window label (AKA title).
      I: iconify
      M: maximize
      C: close
      S: shade (roll up/down)
      D: omnipresent (on all desktops).
  -->
    <keepBorder>yes</keepBorder>
    <animateIconify>no</animateIconify>
    <font place="ActiveWindow">
      <name>Segoe UI</name>
      <size>15</size>
      <!-- font size in points -->
      <weight>bold</weight>
      <!-- 'bold' or 'normal' -->
      <slant>normal</slant>
      <!-- 'italic' or 'normal' -->
    </font>
    <font place="InactiveWindow">
      <name>Segoe UI</name>
      <size>15</size>
      <!-- font size in points -->
      <weight>bold</weight>
      <!-- 'bold' or 'normal' -->
      <slant>normal</slant>
      <!-- 'italic' or 'normal' -->
    </font>
    <font place="MenuHeader">
      <name>Segoe UI</name>
      <size>16</size>
      <!-- font size in points -->
      <weight>normal</weight>
      <!-- 'bold' or 'normal' -->
      <slant>normal</slant>
      <!-- 'italic' or 'normal' -->
    </font>
    <font place="MenuItem">
      <name>Segoe UI</name>
      <size>16</size>
      <!-- font size in points -->
      <weight>normal</weight>
      <!-- 'bold' or 'normal' -->
      <slant>normal</slant>
      <!-- 'italic' or 'normal' -->
    </font>
    <font place="OnScreenDisplay">
      <name>Segoe UI</name>
      <size>12</size>
      <!-- font size in points -->
      <weight>bold</weight>
      <!-- 'bold' or 'normal' -->
      <slant>normal</slant>
      <!-- 'italic' or 'normal' -->
    </font>
    <font place="OnScreenDisplay">
      <name>Segoe UI</name>
      <size>12</size>
      <!-- font size in points -->
      <weight>bold</weight>
      <!-- 'bold' or 'normal' -->
      <slant>normal</slant>
      <!-- 'italic' or 'normal' -->
    </font>
  </theme>
  <desktops number="4">
    <!-- this stuff is only used at startup, pagers allow you to change them
       during a session

       these are default values to use when other ones are not already set
       by other applications, or saved in your session

       use obconf if you want to change these without having to log out
       and back in -->
    <initial>1</initial>
    <names>
      <!-- Distinct zero-width names keep the desktop popup text-free. -->
      <name>&#x200B;</name>
      <name>&#x200B;&#x200B;</name>
      <name>&#x200B;&#x200B;&#x200B;</name>
      <name>&#x200B;&#x200B;&#x200B;&#x200B;</name>
    </names>
    <popupTime>875</popupTime>
    <!-- The number of milliseconds to show the popup for when switching
       desktops.  Set this to 0 to disable the popup. -->
  </desktops>
  <windowSwitcher preview="yes" outlines="yes">
    <osd show="yes" style="classic"/>
    <fields>
      <field content="icon" width="8%"/>
      <field content="title" width="92%"/>
    </fields>
  </windowSwitcher>
  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Never</popupShow>
    <!-- 'Always', 'Never', or 'Nonpixel' (xterms and such) -->
    <popupPosition>Center</popupPosition>
    <!-- 'Center', 'Top', or 'Fixed' -->
    <popupFixedPosition>
      <!-- these are used if popupPosition is set to 'Fixed' -->
      <x>10</x>
      <!-- positive number for distance from left edge, negative number for
         distance from right edge, or 'Center' -->
      <y>10</y>
      <!-- positive number for distance from top edge, negative number for
         distance from bottom edge, or 'Center' -->
    </popupFixedPosition>
  </resize>
  <!-- You can reserve a portion of your screen where windows will not cover when
     they are maximized, or when they are initially placed.
     Many programs reserve space automatically, but you can use this in other
     cases. -->
  <margin top="0" bottom="0" left="0" right="0"/>
  <regions>
    <region name="left-half" x="0%" y="0%" width="50%" height="100%"/>
    <region name="right-half" x="50%" y="0%" width="50%" height="100%"/>
    <region name="top-half" x="0%" y="0%" width="100%" height="50%"/>
    <region name="bottom-half" x="0%" y="50%" width="100%" height="50%"/>
    <region name="left-third" x="0%" y="0%" width="33%" height="100%"/>
    <region name="middle-third" x="33%" y="0%" width="33%" height="100%"/>
    <region name="right-third" x="66%" y="0%" width="34%" height="100%"/>
    <region name="top-left-quarter" x="0%" y="0%" width="50%" height="50%"/>
    <region name="top-right-quarter" x="50%" y="0%" width="50%" height="50%"/>
    <region name="bottom-left-quarter" x="0%" y="50%" width="50%" height="50%"/>
    <region name="bottom-right-quarter" x="50%" y="50%" width="50%" height="50%"/>
    <region name="top-left-third" x="0%" y="0%" width="33%" height="50%"/>
    <region name="top-middle-third" x="33%" y="0%" width="33%" height="50%"/>
    <region name="top-right-third" x="66%" y="0%" width="34%" height="50%"/>
    <region name="bottom-left-third" x="0%" y="50%" width="33%" height="50%"/>
    <region name="bottom-middle-third" x="33%" y="50%" width="33%" height="50%"/>
    <region name="bottom-right-third" x="66%" y="50%" width="34%" height="50%"/>
  </regions>
  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>
    <repeatDelay>150</repeatDelay>
    <repeatRate>50</repeatRate>
    <!-- Keybindings for desktop switching -->
    <!-- Increase backlight 1% -->
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute">
        <command>~/dotfiles/scripts/backlight.sh --inc</command>
      </action>
    </keybind>
    <!-- Decrease backlight 1% -->
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute">
        <command>~/dotfiles/scripts/backlight.sh --dec</command>
      </action>
    </keybind>
    <keybind key="Print">
      <action name="Execute">
        <command>~/scripts/screenshot.sh</command>
      </action>
    </keybind>
    <keybind key="C-A-u">
      <action name="Execute">
        <command>uairctl toggle</command>
      </action>
    </keybind>
    <keybind key="C-A-p">
      <action name="Execute">
        <command>env PASSWORD_STORE_DIR=/home/araaha/.local/share/pass GNUPGHOME=/home/araaha/.local/share/.gnupg rofi-pass.sh</command>
      </action>
    </keybind>
    <keybind key="C-A-r">
      <action name="Execute">
        <command>rofi -show-icons -show drun -modi drun</command>
      </action>
    </keybind>
    <keybind key="C-A-q">
      <action name="Execute">
        <command>rofi -show calc -modi calc -no-show-match -no-sort -terse -no-bold -calc-command "printf '%s' '{result}' | wl-copy" -kb-secondary-copy "" -kb-accept-entry "Return,Control+c"</command>
      </action>
    </keybind>
    <keybind key="C-A-c">
      <action name="Execute">
        <command>sh -c "cliphist list | rofi -dmenu -p 'Clipboard ' -display-columns 2 | cliphist decode | wl-copy"</command>
      </action>
    </keybind>
    <keybind key="C-A-t">
      <!-- Native Wayland dropdown: hide it when focused, otherwise raise the
           existing instance, or launch it when no instance exists. -->
      <action name="ForEach">
        <query identifier="Dropdown"/>
        <then>
          <action name="If">
            <query focused="yes"/>
            <then>
              <action name="Iconify"/>
            </then>
            <else>
              <action name="Focus"/>
              <action name="Raise"/>
            </else>
          </action>
        </then>
        <none>
          <action name="Execute">
            <command>alacritty --class Dropdown --title Dropdown -o 'window.opacity=0.55' -e tmux</command>
          </action>
        </none>
      </action>
    </keybind>
    <keybind key="C-A-a">
      <action name="Execute">
        <command>alacritty -o 'window.startup_mode="Maximized"' -o 'window.opacity=1' -e tmux</command>
      </action>
    </keybind>
    <keybind key="C-A-h">
      <action name="GoToDesktop">
        <to>left</to>
        <wrap>no</wrap>
      </action>
    </keybind>
    <!-- Openbox MoveResizeTo/grid bindings translated to Labwc snap regions. -->
    <keybind key="W-g">
      <action name="ShowMenu"><menu>snap-menu</menu></action>
    </keybind>
    <keybind key="W-h">
      <action name="ToggleSnapToRegion" region="left-half"/>
    </keybind>
    <keybind key="W-l">
      <action name="ToggleSnapToRegion" region="right-half"/>
    </keybind>
    <keybind key="W-k">
      <action name="ToggleSnapToRegion" region="top-half"/>
    </keybind>
    <keybind key="W-j">
      <action name="ToggleSnapToRegion" region="bottom-half"/>
    </keybind>
    <keybind key="W-q">
      <action name="ToggleSnapToRegion" region="left-third"/>
    </keybind>
    <keybind key="W-w">
      <action name="ToggleSnapToRegion" region="middle-third"/>
    </keybind>
    <keybind key="W-e">
      <action name="ToggleSnapToRegion" region="right-third"/>
    </keybind>
    <keybind key="W-1">
      <action name="ToggleSnapToRegion" region="top-left-quarter"/>
    </keybind>
    <keybind key="W-2">
      <action name="ToggleSnapToRegion" region="top-right-quarter"/>
    </keybind>
    <keybind key="W-3">
      <action name="ToggleSnapToRegion" region="bottom-left-quarter"/>
    </keybind>
    <keybind key="W-4">
      <action name="ToggleSnapToRegion" region="bottom-right-quarter"/>
    </keybind>
    <keybind key="W-5">
      <action name="ToggleSnapToRegion" region="top-left-third"/>
    </keybind>
    <keybind key="W-6">
      <action name="ToggleSnapToRegion" region="top-middle-third"/>
    </keybind>
    <keybind key="W-7">
      <action name="ToggleSnapToRegion" region="top-right-third"/>
    </keybind>
    <keybind key="W-t">
      <action name="ToggleSnapToRegion" region="bottom-left-third"/>
    </keybind>
    <keybind key="W-y">
      <action name="ToggleSnapToRegion" region="bottom-middle-third"/>
    </keybind>
    <keybind key="W-u">
      <action name="ToggleSnapToRegion" region="bottom-right-third"/>
    </keybind>
    <keybind key="W-b">
      <action name="Execute">
        <command>pkill -SIGUSR1 waybar</command>
      </action>
    </keybind>
    <keybind key="XF86AudioNext">
      <action name="ToggleMaximize"/>
    </keybind>
    <keybind key="W-f">
      <action name="ToggleMaximize"/>
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>pamixer --allow-boost -i 2</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>pamixer --allow-boost -d 2 </command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>pamixer --toggle-mute</command>
      </action>
    </keybind>
    <keybind key="0xD0">
      <action name="Execute">
        <command>playerctl play-pause</command>
      </action>
    </keybind>
    <keybind key="0xD1">
      <action name="Execute">
        <command>playerctl play-pause</command>
      </action>
    </keybind>
    <keybind key="XF86AudioPlay">
      <action name="Execute">
      <command>playerctl play-pause</command>
      </action>
    </keybind>
    <keybind key="W-x">
      <action name="Execute">
      <command>warpd --hint</command>
      </action>
    </keybind>
    <keybind key="W-c">
      <action name="Execute">
      <command>warpd --normal</command>
      </action>
    </keybind>
    <keybind key="C-A-l">
      <action name="GoToDesktop">
        <to>right</to>
        <wrap>no</wrap>
      </action>
    </keybind>
    <keybind key="C-A-k">
      <action name="GoToDesktop">
        <to>left</to>
        <wrap>no</wrap>
      </action>
    </keybind>
    <keybind key="C-A-j">
      <action name="GoToDesktop">
        <to>right</to>
        <wrap>no</wrap>
      </action>
    </keybind>
    <keybind key="S-A-h">
      <action name="SendToDesktop">
        <to>left</to>
        <wrap>no</wrap>
      </action>
    </keybind>
    <keybind key="S-A-l">
      <action name="SendToDesktop">
        <to>right</to>
        <wrap>no</wrap>
      </action>
    </keybind>
    <keybind key="S-A-k">
      <action name="SendToDesktop">
        <to>left</to>
        <wrap>no</wrap>
      </action>
    </keybind>
    <keybind key="S-A-j">
      <action name="SendToDesktop">
        <to>right</to>
        <wrap>no</wrap>
      </action>
    </keybind>
    <keybind key="W-F1">
      <action name="GoToDesktop">
        <to>1</to>
      </action>
    </keybind>
    <keybind key="W-F2">
      <action name="GoToDesktop">
        <to>2</to>
      </action>
    </keybind>
    <keybind key="W-F3">
      <action name="GoToDesktop">
        <to>3</to>
      </action>
    </keybind>
    <keybind key="W-F4">
      <action name="GoToDesktop">
        <to>4</to>
      </action>
    </keybind>
    <keybind key="W-d">
      <action name="ToggleShowDesktop"/>
    </keybind>
    <!-- Keybindings for windows -->
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <keybind key="A-Escape">
      <action name="Lower"/>
      <action name="Unfocus"/>
    </keybind>
    <keybind key="A-Home">
      <action name="ShowMenu">
        <menu>client-menu</menu>
      </action>
    </keybind>
    <!-- Keybindings for window switching -->
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow"/>
    </keybind>
    <keybind key="C-A-Tab">
      <action name="NextWindow" workspace="all"/>
    </keybind>
    <!-- Labwc has sequential rather than directional focus cycling. -->
    <keybind key="W-S-Right">
      <action name="NextWindowImmediate"/>
    </keybind>
    <keybind key="W-S-Left">
      <action name="PreviousWindowImmediate"/>
    </keybind>
    <keybind key="W-S-Up">
      <action name="PreviousWindowImmediate"/>
    </keybind>
    <keybind key="W-S-Down">
      <action name="NextWindowImmediate"/>
    </keybind>
  </keyboard>
  <mouse>
    <dragThreshold>1</dragThreshold>
    <!-- number of pixels the mouse must move before a drag begins -->
    <doubleClickTime>500</doubleClickTime>
    <!-- in milliseconds (1000 = 1 second) -->
    <screenEdgeWarpTime>400</screenEdgeWarpTime>
    <!-- Time before changing desktops when the pointer touches the edge of the
       screen while moving a window, in milliseconds (1000 = 1 second).
       Set this to 0 to disable warping -->
    <screenEdgeWarpMouse>false</screenEdgeWarpMouse>
    <!-- Set this to TRUE to move the mouse pointer across the desktop when
       switching due to hitting the edge of the screen -->
    <context name="Frame">
      <mousebind button="A-Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="A-Left" action="Click">
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="A-Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="A-Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="A-Right" action="Drag">
        <action name="Resize"/>
      </mousebind>
      <mousebind button="A-Middle" action="Press">
        <action name="Lower"/>
        <action name="Unfocus"/>
      </mousebind>
      <mousebind direction="A-Up" action="Scroll">
        <action name="GoToDesktop">
          <to>left</to>
        </action>
      </mousebind>
      <mousebind direction="A-Down" action="Scroll">
        <action name="GoToDesktop">
          <to>right</to>
        </action>
      </mousebind>
      <mousebind direction="C-A-Up" action="Scroll">
        <action name="GoToDesktop">
          <to>left</to>
        </action>
      </mousebind>
      <mousebind direction="C-A-Down" action="Scroll">
        <action name="GoToDesktop">
          <to>right</to>
        </action>
      </mousebind>
      <mousebind direction="A-S-Up" action="Scroll">
        <action name="SendToDesktop">
          <to>left</to>
        </action>
      </mousebind>
      <mousebind direction="A-S-Down" action="Scroll">
        <action name="SendToDesktop">
          <to>right</to>
        </action>
      </mousebind>
    </context>
    <context name="Titlebar">
      <mousebind button="Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize"/>
      </mousebind>
      <mousebind direction="Up" action="Scroll">
        <action name="If">
          <query shaded="no"/>
          <then>
            <action name="Shade"/>
            <action name="Unfocus"/>
            <action name="Lower"/>
          </then>
        </action>
      </mousebind>
      <mousebind direction="Down" action="Scroll">
        <action name="If">
          <query shaded="yes"/>
          <then>
            <action name="Unshade"/>
            <action name="Raise"/>
          </then>
        </action>
      </mousebind>
    </context>
    <context name="TitleBar">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Lower"/>
        <action name="Unfocus"/>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="ShowMenu">
          <menu>client-menu</menu>
        </action>
      </mousebind>
    </context>
    <context name="Top">
      <mousebind button="Left" action="Drag">
        <action name="Resize" direction="up"/>
      </mousebind>
    </context>
    <context name="Left">
      <mousebind button="Left" action="Drag">
        <action name="Resize" direction="left"/>
      </mousebind>
    </context>
    <context name="Right">
      <mousebind button="Left" action="Drag">
        <action name="Resize" direction="right"/>
      </mousebind>
    </context>
    <context name="Bottom">
      <mousebind button="Left" action="Drag">
        <action name="Resize" direction="down"/>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="ShowMenu">
          <menu>client-menu</menu>
        </action>
      </mousebind>
    </context>
    <context name="Border">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>
    <context name="Icon">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
        <action name="ShowMenu">
          <menu>client-menu</menu>
        </action>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="ShowMenu">
          <menu>client-menu</menu>
        </action>
      </mousebind>
    </context>
    <context name="AllDesktops">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="ToggleOmnipresent"/>
      </mousebind>
    </context>
    <context name="Shade">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="ToggleShade"/>
      </mousebind>
    </context>
    <context name="Iconify">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="Iconify"/>
      </mousebind>
    </context>
    <context name="Maximize">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="ToggleMaximize"/>
      </mousebind>
      <mousebind button="Middle" action="Click">
        <action name="ToggleMaximize" direction="vertical"/>
      </mousebind>
      <mousebind button="Right" action="Click">
        <action name="ToggleMaximize" direction="horizontal"/>
      </mousebind>
    </context>
    <context name="Close">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="Close"/>
      </mousebind>
    </context>
    <context name="Root">
      <mousebind direction="Up" action="Scroll">
        <action name="GoToDesktop">
          <to>left</to>
        </action>
      </mousebind>
      <mousebind direction="Down" action="Scroll">
        <action name="GoToDesktop">
          <to>right</to>
        </action>
      </mousebind>
      <mousebind direction="A-Up" action="Scroll">
        <action name="GoToDesktop">
          <to>left</to>
        </action>
      </mousebind>
      <mousebind direction="A-Down" action="Scroll">
        <action name="GoToDesktop">
          <to>right</to>
        </action>
      </mousebind>
      <mousebind direction="C-A-Up" action="Scroll">
        <action name="GoToDesktop">
          <to>left</to>
        </action>
      </mousebind>
      <mousebind direction="C-A-Down" action="Scroll">
        <action name="GoToDesktop">
          <to>right</to>
        </action>
      </mousebind>
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>
    <context name="Root">
      <!-- Menus -->
      <mousebind button="Middle" action="Press">
        <action name="ShowMenu">
          <menu>client-list-combined-menu</menu>
        </action>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="ShowMenu">
          <menu>root-menu</menu>
        </action>
      </mousebind>
    </context>
  </mouse>
  <menu>
    <!-- You can specify more than one menu file in here and they are all loaded,
       just don't make menu ids clash or, well, it'll be kind of pointless -->
    <!-- default menu file (or custom one in $HOME/.config/openbox/) -->
    <file>menu.xml</file>
    <hideDelay>200</hideDelay>
    <!-- if a press-release lasts longer than this setting (in milliseconds), the
       menu is hidden again -->
    <middle>no</middle>
    <!-- center submenus vertically about the parent entry -->
    <submenuShowDelay>100</submenuShowDelay>
    <!-- time to delay before showing a submenu after hovering over the parent
       entry.
       if this is a negative value, then the delay is infinite and the
       submenu will not be shown until it is clicked on -->
    <submenuHideDelay>400</submenuHideDelay>
    <!-- time to delay before hiding a submenu when selecting another
       entry in parent menu
       if this is a negative value, then the delay is infinite and the
       submenu will not be hidden until a different submenu is opened -->
    <showIcons>yes</showIcons>
    <!-- controls if icons appear in the client-list-(combined-)menu -->
    <manageDesktops>yes</manageDesktops>
    <!-- show the manage desktops section in the client-list-(combined-)menu -->
  </menu>
  <windowRules>
    <windowRule identifier="*" serverDecoration="no"/>
    <windowRule identifier="Dropdown" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="SnapToRegion" region="bottom-half"/>
      <action name="ToggleAlwaysOnTop"/>
      <action name="ToggleOmnipresent"/>
    </windowRule>
  </windowRules>
  <!--

diff --git a/render.c b/render.c
new file mode 100644
--- /dev/null
+++ b/render.c
@@ -0,0 +1,264 @@
+/* XRender image scaling. The X server may accelerate these operations on the GPU. */
+#include "nsxiv.h"
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if HAVE_XRENDER
+#include <X11/extensions/Xrender.h>
+
+enum { LEVELS = 16, MAX_PIXELS = 48 * 1024 * 1024 };
+
+typedef struct {
+	Pixmap pixmap;
+	Picture picture;
+	int w, h;
+} render_level_t;
+
+struct img_accel {
+	render_level_t levels[LEVELS];
+	render_level_t checker;
+	Imlib_Image source;
+	int w, h, gamma, brightness, contrast;
+	bool failed, alpha;
+};
+
+static int render_error;
+
+static int catch_error(Display *dpy, XErrorEvent *event)
+{
+	(void)dpy;
+	(void)event;
+	render_error = 1;
+	return 0;
+}
+
+void img_invalidate_accel(img_t *img)
+{
+	unsigned int i;
+	struct img_accel *a = img->accel;
+
+	if (a == NULL)
+		return;
+	for (i = 0; i < LEVELS; i++) {
+		if (a->levels[i].picture)
+			XRenderFreePicture(img->win->env.dpy, a->levels[i].picture);
+		if (a->levels[i].pixmap)
+			XFreePixmap(img->win->env.dpy, a->levels[i].pixmap);
+	}
+	memset(a->levels, 0, sizeof(a->levels));
+	if (a->checker.picture)
+		XRenderFreePicture(img->win->env.dpy, a->checker.picture);
+	if (a->checker.pixmap)
+		XFreePixmap(img->win->env.dpy, a->checker.pixmap);
+	memset(&a->checker, 0, sizeof(a->checker));
+	a->source = NULL;
+}
+
+void img_free_accel(img_t *img)
+{
+	img_invalidate_accel(img);
+	free(img->accel);
+	img->accel = NULL;
+}
+
+static bool available(img_t *img)
+{
+	Display *dpy = img->win->env.dpy;
+	XFilters *filters;
+	int event, error, major, minor, i;
+	bool bilinear = false;
+	const char *disable = getenv("NSXIV_NO_XRENDER");
+
+	if (disable != NULL && *disable && strcmp(disable, "0") != 0)
+		return false;
+	if (!XRenderQueryExtension(dpy, &event, &error) ||
+	    !XRenderQueryVersion(dpy, &major, &minor) || (major == 0 && minor < 10))
+		return false;
+	if (XRenderFindStandardFormat(dpy, PictStandardARGB32) == NULL ||
+	    XRenderFindVisualFormat(dpy, img->win->env.vis) == NULL)
+		return false;
+	filters = XRenderQueryFilters(dpy, img->win->xwin);
+	if (filters == NULL)
+		return false;
+	for (i = 0; i < filters->nfilter; i++)
+		bilinear |= strcmp(filters->filter[i], FilterBilinear) == 0;
+	XFree(filters);
+	return bilinear;
+}
+
+static bool upload(img_t *img, unsigned int level)
+{
+	win_t *win = img->win;
+	Display *dpy = win->env.dpy;
+	struct img_accel *a = img->accel;
+	render_level_t *l = &a->levels[level];
+	Imlib_Image scaled = NULL;
+	const uint32_t *pixels;
+	XImage *image;
+	XRenderPictureAttributes attr = { .repeat = RepeatPad };
+	XRenderPictFormat *format = XRenderFindStandardFormat(dpy, PictStandardARGB32);
+	uint8_t red[256], green[256], blue[256], alpha[256];
+	unsigned int x, y, r, g, b, opacity;
+	uint32_t pixel;
+	GC gc;
+	int (*previous)(Display*, XErrorEvent*);
+
+	l->w = MAX(1, img->w >> level);
+	l->h = MAX(1, img->h >> level);
+	imlib_context_set_image(img->im);
+	if (level != 0) {
+		/* Cache filtered reductions so zooming out does not alias fine detail. */
+		imlib_context_set_anti_alias(1);
+		imlib_context_set_color_modifier(NULL);
+		scaled = imlib_create_cropped_scaled_image(0, 0, img->w, img->h, l->w, l->h);
+		imlib_context_set_color_modifier(img->cmod);
+		if (scaled == NULL)
+			return false;
+		imlib_context_set_image(scaled);
+	}
+	pixels = imlib_image_get_data_for_reading_only();
+	image = XCreateImage(dpy, win->env.vis, 32, ZPixmap, 0, NULL, l->w, l->h, 32, 0);
+	if (image == NULL || pixels == NULL) {
+		if (image != NULL)
+			XDestroyImage(image);
+		if (scaled != NULL)
+			imlib_free_image();
+		imlib_context_set_image(img->im);
+		return false;
+	}
+	image->data = malloc((size_t)image->bytes_per_line * l->h);
+	if (image->data == NULL) {
+		XDestroyImage(image);
+		if (scaled != NULL)
+			imlib_free_image();
+		imlib_context_set_image(img->im);
+		return false;
+	}
+	imlib_context_set_color_modifier(img->cmod);
+	imlib_get_color_modifier_tables(red, green, blue, alpha);
+	for (y = 0; y < (unsigned int)l->h; y++) {
+		for (x = 0; x < (unsigned int)l->w; x++) {
+			pixel = pixels[(size_t)y * l->w + x];
+			opacity = a->alpha ? alpha[pixel >> 24] : 255;
+			r = (red[(pixel >> 16) & 255] * opacity + 127) / 255;
+			g = (green[(pixel >> 8) & 255] * opacity + 127) / 255;
+			b = (blue[pixel & 255] * opacity + 127) / 255;
+			XPutPixel(image, x, y, (opacity << 24) | (r << 16) | (g << 8) | b);
+		}
+	}
+	if (scaled != NULL)
+		imlib_free_image();
+	imlib_context_set_image(img->im);
+
+	/* Resource exhaustion must fall back instead of terminating the viewer. */
+	XSync(dpy, False);
+	render_error = 0;
+	previous = XSetErrorHandler(catch_error);
+	l->pixmap = XCreatePixmap(dpy, win->xwin, l->w, l->h, 32);
+	l->picture = XRenderCreatePicture(dpy, l->pixmap, format, CPRepeat, &attr);
+	gc = XCreateGC(dpy, l->pixmap, 0, NULL);
+	XPutImage(dpy, l->pixmap, gc, image, 0, 0, 0, 0, l->w, l->h);
+	XFreeGC(dpy, gc);
+	XDestroyImage(image);
+	if (!a->checker.picture) {
+		XRenderColor dark = {0x6666, 0x6666, 0x6666, 0xffff};
+		XRenderColor light = {0x9999, 0x9999, 0x9999, 0xffff};
+		attr.repeat = RepeatNormal;
+		a->checker.pixmap = XCreatePixmap(dpy, win->xwin, 16, 16, 32);
+		a->checker.picture = XRenderCreatePicture(dpy, a->checker.pixmap, format, CPRepeat, &attr);
+		XRenderFillRectangle(dpy, PictOpSrc, a->checker.picture, &dark, 0, 0, 16, 16);
+		XRenderFillRectangle(dpy, PictOpSrc, a->checker.picture, &light, 8, 0, 8, 8);
+		XRenderFillRectangle(dpy, PictOpSrc, a->checker.picture, &light, 0, 8, 8, 8);
+	}
+	XSync(dpy, False);
+	if (render_error) {
+		img_invalidate_accel(img);
+		XSync(dpy, False);
+	}
+	XSetErrorHandler(previous);
+	return !render_error;
+}
+
+bool img_render_accel(img_t *img, int sx, int sy, int sw, int sh,
+                      int dx, int dy, int dw, int dh)
+{
+	win_t *win = img->win;
+	Display *dpy = win->env.dpy;
+	struct img_accel *a;
+	render_level_t *l;
+	Picture dest;
+	XTransform transform = {{{0}}};
+	int width, height;
+	unsigned int level = 0;
+
+	if (img->w <= 0 || img->h <= 0 || img->w > 32767 || img->h > 32767 ||
+	    (int64_t)img->w * img->h > MAX_PIXELS || img->multi.cnt > 1 ||
+	    sw <= 0 || sh <= 0 || dw <= 0 || dh <= 0)
+		return false;
+	if (img->accel == NULL) {
+		img->accel = calloc(1, sizeof(*img->accel));
+		if (img->accel == NULL)
+			return false;
+		img->accel->failed = !available(img);
+	}
+	a = img->accel;
+	if (a->failed)
+		return false;
+	if (a->source != img->im || a->w != img->w || a->h != img->h ||
+	    a->gamma != img->gamma || a->brightness != img->brightness ||
+	    a->contrast != img->contrast)
+	{
+		img_invalidate_accel(img);
+		a->source = img->im;
+		a->w = img->w;
+		a->h = img->h;
+		a->gamma = img->gamma;
+		a->brightness = img->brightness;
+		a->contrast = img->contrast;
+		imlib_context_set_image(img->im);
+		a->alpha = imlib_image_has_alpha();
+	}
+	while (img->anti_alias && level + 1 < LEVELS &&
+	       img->zoom * (1U << (level + 1)) <= 1.0 &&
+	       (img->w >> (level + 1)) > 0 && (img->h >> (level + 1)) > 0)
+		level++;
+	l = &a->levels[level];
+	if (!l->picture && !upload(img, level)) {
+		a->failed = true;
+		return false;
+	}
+	width = MIN(dw, (int)win->w - dx);
+	height = MIN(dh, (int)win->h - dy + (win->bar.top ? (int)win->bar.h : 0));
+	if (width <= 0 || height <= 0)
+		return false;
+
+	win_clear(win);
+	dest = XRenderCreatePicture(dpy, win->buf.pm,
+	                           XRenderFindVisualFormat(dpy, win->env.vis), 0, NULL);
+	if (a->alpha && img->alpha_layer)
+		XRenderComposite(dpy, PictOpSrc, a->checker.picture, None, dest,
+		                 0, 0, 0, 0, dx, dy, width, height);
+	transform.matrix[0][0] = XDoubleToFixed((double)sw * l->w / img->w / dw);
+	transform.matrix[1][1] = XDoubleToFixed((double)sh * l->h / img->h / dh);
+	transform.matrix[0][2] = XDoubleToFixed((double)sx * l->w / img->w);
+	transform.matrix[1][2] = XDoubleToFixed((double)sy * l->h / img->h);
+	transform.matrix[2][2] = XDoubleToFixed(1);
+	XRenderSetPictureTransform(dpy, l->picture, &transform);
+	XRenderSetPictureFilter(dpy, l->picture, img->anti_alias ? FilterBilinear : FilterNearest, NULL, 0);
+	XRenderComposite(dpy, PictOpOver, l->picture, None, dest, 0, 0, 0, 0, dx, dy, width, height);
+	XRenderFreePicture(dpy, dest);
+	return true;
+}
+
+#else
+bool img_render_accel(img_t *img, int sx, int sy, int sw, int sh,
+                      int dx, int dy, int dw, int dh)
+{
+	(void)img; (void)sx; (void)sy; (void)sw; (void)sh;
+	(void)dx; (void)dy; (void)dw; (void)dh;
+	return false;
+}
+void img_invalidate_accel(img_t *img) { (void)img; }
+void img_free_accel(img_t *img) { (void)img; }
+#endif

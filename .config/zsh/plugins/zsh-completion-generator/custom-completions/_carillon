(( $+functions[_carillon_commands] )) ||
_carillon_commands() {
    local commands; commands=(
'watch:Watch a mailbox and fire hooks on every change until Ctrl+C' \
'check:Validate the account configuration against each allowed backend' \
'configure:Configure an account interactively' \
'wizard:Configure an account interactively' \
'manual:Generate man pages into the given directory' \
'completion:Generate shell completion scripts into the given directory' \
'json-schema:Generate the JSON Schema of a command'\''s \`--json\` output' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'carillon commands' commands "$@"
}

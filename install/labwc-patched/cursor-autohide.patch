+static int
+cursor_hide_timeout(void *data)
+{
+	struct seat *seat = data;
+	if (rc.cursor_hide_timeout <= 0) {
+		return 0;
+	}
+	/* Keep the cursor visible while holding a button or moving/resizing. */
+	if (seat->wlr_seat->pointer_state.button_count
+			|| server.input_mode != LAB_INPUT_STATE_PASSTHROUGH
+			|| seat->drag.active) {
+		wl_event_source_timer_update(seat->cursor_hide_timer,
+			rc.cursor_hide_timeout);
+		return 0;
+	}
+	cursor_set_visible(seat, false);
+	wlr_log(WLR_DEBUG, "Cursor hidden after pointer inactivity");
+	return 0;
+}
+
 void
 cursor_set_visible(struct seat *seat, bool visible)
 {
+	/* Pointer, gesture and tablet activity reset this; keyboard input does not. */
+	if (seat->cursor_hide_timer) {
+		wl_event_source_timer_update(seat->cursor_hide_timer,
+			visible ? rc.cursor_hide_timeout : 0);
+	}
 	if (seat->cursor_visible == visible) {
 		return;
 	}
